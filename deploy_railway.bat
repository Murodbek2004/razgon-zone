@echo off
chcp 65001 >nul
echo ========================================================
echo    🚀 RAZGON ZONE - РАЗВЕРТЫВАНИЕ НА RAILWAY
echo ========================================================
echo.

echo [1/3] Проверка Railway CLI...
railway --version
if errorlevel 1 (
    echo [ОШИБКА] Railway CLI не обнаружен.
    pause
    exit /b 1
)

echo.
echo [2/3] Авторизация в Railway...
echo (Если откроется браузер, подтвердите вход в свой аккаунт)
railway login

echo.
echo [3/3] Деплой проекта в облако Railway...
railway up

echo.
echo ========================================================
echo    🎉 Развертывание запущено! Проверьте логи в консоли.
echo ========================================================
pause
